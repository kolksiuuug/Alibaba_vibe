# Пример настроек. Для запуска .env НЕ нужен: docker-compose.yml содержит те же значения по умолчанию.
# Чтобы поменять значение, скопируйте файл в .env и отредактируйте (.env в .gitignore).

# Приложение: prod | dev | test
APP_CONFIG=prod
# Ключ подписи токенов демо-входа. Значение по умолчанию подходит только для демо.
SECRET_KEY=demo-only-secret-change-me
LOG_LEVEL=INFO

# PostgreSQL
POSTGRES_USER=credit
POSTGRES_PASSWORD=credit
POSTGRES_DB=credit

# Порты на хосте
NGINX_PORT=8080
MOCKS_PORT=8001

# Ключевая ставка ЦБ, % годовых (на 23.10.2026)
KEY_RATE=14.0

# Задержка шагов конвейера, мс: чтобы на демо было видно движение статуса
PIPELINE_STEP_DELAY_MS=700

# Доля случайных отказов моков внешних систем, 0..1
MOCKS_FAILURE_RATE=0

# LLM-ассистент необязателен; основной сценарий работает без него
LLM_ENABLED=false
