{
  "name": "credit-cabinet-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scarfSettings": {
    "enabled": false
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "gen:api": "openapi-typescript ../docs/openapi.yaml -o src/api/schema.d.ts",
    "format": "prettier --write src",
    "e2e": "playwright test",
    "lint": "eslint . && tsc --noEmit"
  },
  "dependencies": {
    "@mantine/core": "7.17.8",
    "@mantine/hooks": "7.17.8",
    "@tabler/icons-react": "3.49.0",
    "@tanstack/react-query": "5.104.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.5.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "swagger-ui-dist": "5.34.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5"
  }
}
