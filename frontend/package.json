{
  "name": "credit-cabinet-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scarfSettings": {
    "enabled": false
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "gen:api": "openapi-typescript ../docs/openapi.yaml -o src/api/schema.d.ts",
    "format": "prettier --write src"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.6"
  },
  "devDependencies": {
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.1.2",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "swagger-ui-dist": "5.34.0",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
